{
  "name": "server4test",
  "description": "server for test",
  "version": "2.1.0",
  "files": [
    "lib"
  ],
  "author": "Codenautas <codenautas@googlegroups.com>",
  "repository": "codenautas/server4test",
  "license": "MIT",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    }
  ],
  "main": "lib/server4test.js",
  "types": "lib/server4test.d.ts",
  "bin": {
    "server4test": "./lib/launch4test.js"
  },
  "overrides": {
    "@babel/core": ">=7.29.6",
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "stylus": {
      "glob": "^11"
    },
    "uuid": ">=14.0.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "fs-extra": "^11.4.1",
    "serve-index": "^1.9.2",
    "best-globals": "^2.2.3",
    "cast-error": "^0.1.6",
    "mini-tools": "^1.13.12",
    "serve-content": "^1.0.8"
  },
  "peerDependencies": {
    "webpack": "^5.109.2",
    "webpack-dev-middleware": "^8.1.0"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    },
    "webpack-dev-middleware": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/serve-index": "^1.9.4",
    "es5-shim": "^4.6.7",
    "fetch-ie8": "^1.5.0",
    "mocha": "^12.0.3",
    "whatwg-fetch": "^3.6.20",
    "qa-control": "^0.14.1",
    "require-bro": "^0.4.2",
    "types.d.ts": "^0.7.3",
    "mixin-patch": "^1.1.0",
    "c8": "^12.0.0",
    "typescript-eslint": "^8.72.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^78.0.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "start": "(mkdir local-file-store || echo 'using local-file-store') && node lib/launch4test.js",
    "start-super-insecure": "(mkdir local-file-store || echo 'using local-file-store') && node lib/launch4test.js --super-insecure",
    "test-ci": "tsc -p test && mixin-patch && c8 --reporter=lcov --reporter=text-summary --include=local-test/src/** mocha --reporter spec --check-leaks local-test/test/",
    "test": "tsc -p test && mixin-patch && mocha --reporter spec --check-leaks local-test/test/",
    "example": "tsc -p example && node example/local-built/example/example-server.js",
    "prepublish": "npm run build",
    "build": "tsc && mixin-patch",
    "preversion": "npm test",
    "version": "npm run build",
    "mixin-patch": "mixin-patch"
  },
  "qa-control": {
    "coverage": 80,
    "run-in": "client",
    "type": "lib",
    "gha": "all",
    "test-appveyor": true,
    "multilang": "yes",
    "sonar": true,
    "silenced": [
      [
        "eslint_warnings_in_file_1",
        "src/server4test-browser-assert.js"
      ]
    ]
  },
  "mixin-patch": {
    "patch": [
      "lib/launch4test.js"
    ],
    "copy": [
      {
        "from": "src",
        "to": "lib"
      },
      {
        "from": "src",
        "to": "local-test/src"
      }
    ]
  }
}
