{
  "name": "server4test",
  "description": "server for test",
  "version": "2.0.0-rc.0",
  "files": [
    "lib"
  ],
  "author": "Codenautas <codenautas@googlegroups.com>",
  "repository": "codenautas/server4test",
  "license": "MIT",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    }
  ],
  "main": "lib/server4test.js",
  "types": "lib/server4test.d.ts",
  "bin": {
    "server4test": "./lib/launch4test.js"
  },
  "overrides": {
    "@babel/core": ">=7.29.6",
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "stylus": {
      "glob": "^11"
    },
    "uuid": ">=14.0.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "serve-index": "^1.9.2",
    "best-globals": "^2.2.2",
    "cast-error": "^0.1.5",
    "mini-tools": "^1.13.10",
    "serve-content": "^1.0.5"
  },
  "peerDependencies": {
    "webpack": "^5.109.2",
    "webpack-dev-middleware": "^8.1.0"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    },
    "webpack-dev-middleware": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/serve-index": "^1.9.4",
    "es5-shim": "^4.6.7",
    "fetch-ie8": "^1.5.0",
    "mocha": "^12.0.0-rc.5",
    "whatwg-fetch": "^3.6.20",
    "qa-control": "^0.9.1",
    "require-bro": "^0.3.6",
    "types.d.ts": "^0.6.22",
    "mixin-patch": "^1.0.0-rc.3"
  },
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "start": "(mkdir local-file-store || echo 'using local-file-store') && node lib/launch4test.js",
    "start-super-insecure": "(mkdir local-file-store || echo 'using local-file-store') && node lib/launch4test.js --super-insecure",
    "test-ci": "istanbul cover node_modules/mocha/bin/_mocha --report lcovonly -- --reporter spec --check-leaks test/",
    "test-cov": "istanbul cover node_modules/mocha/bin/_mocha -- --reporter dot --check-leaks test/",
    "test": "tsc -p test && mocha --report lcovonly -- --reporter spec --check-leaks local-test/test/",
    "example": "tsc -p example && node example/local-built/example/example-server.js",
    "prepublish": "npm run build",
    "build": "tsc && mixin-patch",
    "preversion": "npm test",
    "version": "npm run build",
    "postversion": "git push && git push --tags",
    "mixin-patch": "mixin-patch"
  },
  "qa-control": {
    "coverage": 0,
    "run-in": "client",
    "type": "lib",
    "gha": "all",
    "test-appveyor": true,
    "multilang": "yes"
  },
  "mixin-patch": {
    "patch": [
      "lib/launch4test.js"
    ]
  }
}
